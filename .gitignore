# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.claude/

# Vite build output (deployed via GitHub Actions to gh-pages)
dist/

# Next.js dev server residue (can reappear if run accidentally; never used by the Vite build)
.next/

# vercel
.vercel

# typescript
*.tsbuildinfo

# supabase CLI local state
supabase/.temp/

# AI agent tooling (kept locally, not versioned)
.agents/
skills-lock.json
